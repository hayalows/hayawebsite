{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkm.hayalows.com/webmcp/results.schema.json",
  "title": "Papa Kojo Mensah WebMCP result contracts",
  "description": "Versioned result contracts for the six distinct WebMCP jobs exposed by pkm.hayalows.com. Each contract is registered as outputSchema and returned as structuredContent.",
  "oneOf": [
    { "$ref": "#/$defs/ProfileResult" },
    { "$ref": "#/$defs/SkillsResult" },
    { "$ref": "#/$defs/ExperienceResult" },
    { "$ref": "#/$defs/EducationResult" },
    { "$ref": "#/$defs/ProjectsResult" },
    { "$ref": "#/$defs/EmailDraftResult" }
  ],
  "$defs": {
    "ProfileResult": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": "2.0.0" },
        "schemaUrl": { "const": "https://pkm.hayalows.com/webmcp/results.schema.json" },
        "fullName": { "const": "Papa Kojo Mensah" },
        "headline": { "const": "Operations and Customer Experience Professional" },
        "location": { "const": "Ghana" },
        "availability": { "const": "Open to thoughtful work globally" },
        "summary": { "type": "string" },
        "canonicalProfileUrl": { "const": "https://pkm.hayalows.com/" },
        "resumeUrl": { "const": "https://pkm.hayalows.com/resume/" },
        "linkedInUrl": { "const": "https://www.linkedin.com/in/papakojomensah" }
      },
      "required": ["schemaVersion", "schemaUrl", "fullName", "headline", "location", "availability", "summary", "canonicalProfileUrl", "resumeUrl", "linkedInUrl"],
      "additionalProperties": false
    },
    "SkillGroup": {
      "type": "object",
      "properties": {
        "key": { "enum": ["operations_service", "data_tools", "brand_delivery"] },
        "title": { "type": "string" },
        "skills": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "evidence": { "type": "string" }
      },
      "required": ["key", "title", "skills", "evidence"],
      "additionalProperties": false
    },
    "SkillsResult": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": "2.0.0" },
        "schemaUrl": { "const": "https://pkm.hayalows.com/webmcp/results.schema.json" },
        "category": { "enum": ["all", "operations_service", "data_tools", "brand_delivery"] },
        "groups": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/SkillGroup" } },
        "sourceUrl": { "const": "https://pkm.hayalows.com/#skills" }
      },
      "required": ["schemaVersion", "schemaUrl", "category", "groups", "sourceUrl"],
      "additionalProperties": false
    },
    "Experience": {
      "type": "object",
      "properties": {
        "key": { "enum": ["springboard", "absa_bank_ghana", "iconka_designs"] },
        "organization": { "type": "string" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "summary": { "type": "string" },
        "highlights": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "required": ["key", "organization", "title", "location", "startDate", "endDate", "summary", "highlights"],
      "additionalProperties": false
    },
    "ExperienceResult": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": "2.0.0" },
        "schemaUrl": { "const": "https://pkm.hayalows.com/webmcp/results.schema.json" },
        "organization": { "enum": ["all", "springboard", "absa_bank_ghana", "iconka_designs"] },
        "roles": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/Experience" } },
        "sourceUrl": { "const": "https://pkm.hayalows.com/#experience" }
      },
      "required": ["schemaVersion", "schemaUrl", "organization", "roles", "sourceUrl"],
      "additionalProperties": false
    },
    "Education": {
      "type": "object",
      "properties": {
        "key": { "enum": ["hospitality_tourism", "professional_training", "actuarial_science", "social_media_marketing", "google_project_management"] },
        "qualification": { "type": "string" },
        "institution": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "year": { "type": "string" },
        "detail": { "type": "string" }
      },
      "required": ["key", "qualification", "institution", "year", "detail"],
      "additionalProperties": false
    },
    "EducationResult": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": "2.0.0" },
        "schemaUrl": { "const": "https://pkm.hayalows.com/webmcp/results.schema.json" },
        "credential": { "enum": ["all", "hospitality_tourism", "professional_training", "actuarial_science", "social_media_marketing", "google_project_management"] },
        "credentials": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/Education" } },
        "sourceUrl": { "const": "https://pkm.hayalows.com/#education" }
      },
      "required": ["schemaVersion", "schemaUrl", "credential", "credentials", "sourceUrl"],
      "additionalProperties": false
    },
    "Project": {
      "type": "object",
      "properties": {
        "key": { "enum": ["routelab", "hayalows_ventures", "english_chat_finder"] },
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "summary": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      },
      "required": ["key", "name", "kind", "summary", "url"],
      "additionalProperties": false
    },
    "ProjectsResult": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": "2.0.0" },
        "schemaUrl": { "const": "https://pkm.hayalows.com/webmcp/results.schema.json" },
        "project": { "enum": ["all", "routelab", "hayalows_ventures", "english_chat_finder"] },
        "projects": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/Project" } },
        "sourceUrl": { "const": "https://pkm.hayalows.com/projects/" }
      },
      "required": ["schemaVersion", "schemaUrl", "project", "projects", "sourceUrl"],
      "additionalProperties": false
    },
    "EmailDraftResult": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": "2.0.0" },
        "schemaUrl": { "const": "https://pkm.hayalows.com/webmcp/results.schema.json" },
        "status": { "const": "draft_ready" },
        "recipient": { "const": "mpapakojo@gmail.com" },
        "subject": { "type": "string", "minLength": 3, "maxLength": 160 },
        "message": { "type": "string", "minLength": 10, "maxLength": 3000 },
        "sent": { "const": false },
        "nextStep": { "type": "string" },
        "sourceUrl": { "const": "https://pkm.hayalows.com/#contact" }
      },
      "required": ["schemaVersion", "schemaUrl", "status", "recipient", "subject", "message", "sent", "nextStep", "sourceUrl"],
      "additionalProperties": false
    }
  }
}
